# GeneTropica — Streamlit secrets template
# Copy to .streamlit/secrets.toml (local) or paste into the Streamlit Cloud
# app's Settings -> Secrets. Both are gitignored / never committed.
#
# The interactive DASHBOARD needs NO secrets: it reads a local SQLite database
# and precomputed result files, and makes no external API calls at runtime.
#
# The values below are OPTIONAL and only matter if you RE-RUN the data
# pipeline (literature mining / conservation alignment), not for serving
# the dashboard.

# NCBI E-utilities (PubMed literature mining) — optional.
# Without these, PubMed queries use the anonymous rate limit (~3 requests/sec).
# NCBI_EMAIL = "you@example.com"
# NCBI_API_KEY = "your-ncbi-api-key"

# EBI Clustal Omega (conservation alignment) — optional; EBI requires a
# contact email for job submission.
# EBI_EMAIL = "you@example.com"
