; NVT equilibration parameters — 100 ps at 300 K
; Target: DENV NS5 RdRp (5CCV) + drug ligand

integrator          = md
nsteps              = 50000
dt                  = 0.002

nstxout-compressed  = 5000
nstenergy           = 5000
nstlog              = 5000

continuation        = no
constraint_algorithm = lincs
constraints         = h-bonds
lincs_iter          = 1
lincs_order         = 4

cutoff-scheme       = Verlet
ns_type             = grid
nstlist             = 10
rcoulomb            = 1.0
rvdw                = 1.0
coulombtype         = PME
pme_order           = 4
fourierspacing      = 0.16

tcoupl              = V-rescale
tc-grps             = Protein_LIG Water_and_ions
tau_t               = 0.1 0.1
ref_t               = 300 300

pcoupl              = no

pbc                 = xyz
DispCorr            = EnerPres

gen_vel             = yes
gen_temp            = 300
gen_seed            = -1
